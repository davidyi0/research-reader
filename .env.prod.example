# Copy to .env.prod ON THE EC2 HOST (never commit the real file — same
# .gitignore pattern that already covers .env covers .env.prod).
#
# Deploy with (from the same directory as docker-compose.prod.yml):
#   set -a && . ./.env.prod && set +a && docker compose -f docker-compose.prod.yml up -d --build
# The `set -a && . ./.env.prod` part matters: docker compose's ${VAR}
# substitution (used for the frontend build args) only reads the shell
# environment or a file literally named .env — env_file: entries are
# injected into containers at runtime only, not seen at build time.

# --- Postgres --- pick a real password, not the local dev default.
POSTGRES_USER=studylens
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=studylens
DATABASE_URL=postgresql+psycopg://studylens:replace-me@postgres:5432/studylens

# --- LLM provider --- reuse the local Groq values or issue a fresh key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_MAX_CONTEXT_TOKENS=3000
LLM_TIMEOUT_SECONDS=60
LLM_SUPPORTS_VISION=false

# --- Storage ---
STORAGE_DIR=/data/storage

# --- CORS: the EC2 public IP (or domain, if HTTPS gets added later) ---
FRONTEND_ORIGIN=http://replace-with-ec2-ip

# --- Auth: Google Sign-In ---
# Add this same origin (http://<ec2-ip>) to the OAuth client's "Authorized
# JavaScript origins" in Google Cloud Console before testing sign-in.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

JWT_SECRET=replace-me
JWT_EXPIRES_DAYS=30

# Real lab roster — required before sharing the URL, not optional.
ALLOWED_EMAILS=
