# Copy to .env and fill in. Compose reads this file automatically.

# --- Postgres (values must match the `postgres` service in docker-compose.yml) ---
POSTGRES_USER=studylens
POSTGRES_PASSWORD=studylens
POSTGRES_DB=studylens

DATABASE_URL=postgresql+psycopg://studylens:studylens@postgres:5432/studylens

# --- LLM provider -------------------------------------------------------------
# Any OpenAI-compatible endpoint. Nothing above app/services/llm/ knows or cares
# which one is configured, so switching is a change to these values alone.
#
#   Groq        https://api.groq.com/openai/v1        console.groq.com  (free tier, fastest)
#   Cerebras    https://api.cerebras.ai/v1            cloud.cerebras.ai (free tier, fast)
#   OpenRouter  https://openrouter.ai/api/v1          openrouter.ai     (free `:free` models)
#   Ollama      http://host.docker.internal:11434/v1  local, no key needed
#   OpenAI      https://api.openai.com/v1
#
# Model IDs change often and differ per provider — check your provider's model
# list rather than trusting a default. Groq and Cerebras publish theirs at
# GET {LLM_BASE_URL}/models.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# Context budget for an explanation request. Raise this if you point at a
# frontier model and want whole-paper context instead of scoped context.
LLM_MAX_CONTEXT_TOKENS=3000
LLM_TIMEOUT_SECONDS=60

# Figure/region explanation requires a vision-capable model. Leave false unless
# LLM_MODEL above accepts image input.
LLM_SUPPORTS_VISION=false

# --- Storage ------------------------------------------------------------------
# Inside the container; the compose bind mount lands it in ./storage on the host.
# Kept outside /app because uvicorn --reload watches that path.
STORAGE_DIR=/data/storage

# --- CORS: where the Vite dev server runs ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth: Google Sign-In --------------------------------------------------
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials — no client secret
# needed, just the client ID (the frontend uses Google's Sign-In button,
# which returns an ID token directly; the backend verifies it against this
# same ID). Add http://localhost:5173 under "Authorized JavaScript origins".
# Same value goes to both vars below (one read by the backend, one exposed to
# the frontend build via the VITE_ prefix).
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Signs our own session JWT after a Google token verifies. Any long random
# string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me
JWT_EXPIRES_DAYS=30

# Comma-separated allowlist of emails who may sign in. Leave empty during
# local dev; set this before sharing the URL with your lab so a stray Google
# account can't just complete the OAuth flow and get in.
ALLOWED_EMAILS=
